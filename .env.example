PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://classsync:change-me@localhost:5432/classsync
REDIS_URL=redis://localhost:6379

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts
JWT_HOURS=8

# Students may log in with any email on this domain (confirm the real domain)
STUDENT_DOMAIN=@spit.ac.in
# First super admin, created by: npm run seed
SUPERADMIN_EMAIL=

# Leave SMTP_HOST empty in development: codes are printed in the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ClassSync <no-reply@example.com>

# Set to 1 when running behind a reverse proxy, so rate limits see the real client IP
TRUST_PROXY=
# Requests per minute allowed from one IP across the whole API
API_PER_MINUTE=600
